package com.day2;

import java.util.LinkedList;

public class EmployeeData {

	public static void main(String[] args) {
		LinkedList <Employee> emp= new LinkedList<Employee>();
		emp.add(new Employee(1,"Faruk",3000));
		emp.add(new Employee(2,"Sahil",4000));
		emp.add(new Employee(3,"Mohan",7000));
		emp.add(new Employee(4,"Ravi",10000));
		emp.add(new Employee(5,"Ishan",12000));
		for(Employee empData : emp) {
			empData.displayDetails();
		}
		
		System.out.println("----------------------");
		System.out.println("Second element of a collection: "+emp.get(2));
		System.out.println("----------------------");
		emp.remove(3);
		System.out.println("After Removing");
		System.out.println(emp);
		System.out.println("----------------------");
		emp.add(null);
		System.out.println("After Adding Null");
		System.out.println(emp);
		
		

	}

}
